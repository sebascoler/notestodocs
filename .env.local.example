# ─── Google OAuth (solo para login en la web app) ───────────────────────────
# Conseguir en: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=genera-un-secret-aleatorio-aqui
NEXTAUTH_URL=http://localhost:3000

# ─── Google Service Account (para Vision API + Docs API) ────────────────────
# Conseguir en: console.cloud.google.com → IAM → Service Accounts → Create → descargar JSON
# Pegar aquí TODO el contenido del JSON en una sola línea (sin saltos de línea)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"notestodocs@tu-proyecto.iam.gserviceaccount.com","token_uri":"https://oauth2.googleapis.com/token"}

# ─── iOS Shortcut auth ───────────────────────────────────────────────────────
# Cualquier string aleatorio; este mismo valor va en el Shortcut del iPad
# Generar con: openssl rand -hex 20
API_KEY=tu-api-key-para-el-shortcut

# ─── Destino de los Google Docs ──────────────────────────────────────────────
# Opción A: ID de la carpeta de Drive que compartiste con el service account
# (la URL de la carpeta es: drive.google.com/drive/folders/ESTE-ID)
GOOGLE_DRIVE_FOLDER_ID=

# Opción B: email del propietario. Si no hay FOLDER_ID, el doc se compartirá con este email
OWNER_EMAIL=tu-email@gmail.com
